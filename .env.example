# Discord bot token (Developer Portal -> Bot -> Token). Enable the
# MESSAGE CONTENT and VOICE intents for the bot.
DISCORD_BOT_TOKEN=

# Optional: restrict the bot to one guild while testing
DISCORD_GUILD_ID=

# Local LLM endpoint (OpenAI-compatible). Ollama default shown.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# Optional IMAP fallback for check_email when Mail.app isn't configured
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
